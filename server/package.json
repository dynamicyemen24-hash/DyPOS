{
  "name": "dypos-server",
  "version": "1.25.1",
  "description": "DyPOS SaaS backend - REST API + JWT Auth + SQLite (node:sqlite, zero native deps)",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --import ./tests/setup.js \"tests/**/*.test.js\"",
    "test:stock-strict": "node --test --import ./tests/setup-strict.js --import ./tests/setup.js tests/stock-guard-strict.test.js",
    "doctor": "node scripts/doctor.mjs",
    "test:watch": "node --watch --import ./tests/setup.js \"tests/**/*.test.js\"",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-restore.mjs",
    "load": "node scripts/load-test.mjs",
    "campaign": "node scripts/stress-campaign.mjs",
    "parity": "node scripts/check-pg-parity.mjs",
    "load:k6": "k6 run -e BASE=http://localhost:3001 tests/load/k6-invoices.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  }
}
