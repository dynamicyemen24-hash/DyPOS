# ─────────────────────────────────────────────────────────
# DyPOS Server — Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy to .env and fill in values:
#   cp .env.example .env

# Server
DYPOS_PORT=3001
DYPOS_HOST=0.0.0.0
NODE_ENV=development

# Authentication — MUST be >= 32 characters in production!
# Generate with: openssl rand -base64 48
DYPOS_JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# JWT expiry (e.g. 24h, 7d)
DYPOS_JWT_EXPIRES=24h

# Database
# For development: relative path (SQLite)
DYPOS_DB_PATH=./data/dypos.db
# For production with PostgreSQL:
# DYPOS_DB_PATH=postgresql://dypos:password@db:5432/dypos

# CORS — set to your front-end domain(s), comma-separated
# NEVER use "*" in production when credentials are required!
DYPOS_CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Frontend dist path (where Vite build output lives)
# DYPOS_FRONTEND_DIST=./DyPOS/public/pos
