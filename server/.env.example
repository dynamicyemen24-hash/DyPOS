# ─────────────────────────────────────────────────────────
# DyPOS Server — Environment Configuration (production-ready)
# ─────────────────────────────────────────────────────────
# Copy to .env and fill in values:
#   cp .env.example .env

# Server
DYPOS_PORT=3001
DYPOS_HOST=0.0.0.0
NODE_ENV=production

# Multi-core throughput: 1 = fork one worker per CPU (recommended for millions of req/day)
# Optionally cap with DYPOS_WORKERS=4
DYPOS_CLUSTER=1
# DYPOS_WORKERS=4

# Timeouts / limits (DoS + slow-client protection)
DYPOS_SERVER_TIMEOUT=30000
DYPOS_BODY_LIMIT=1mb
DYPOS_TRUST_PROXY=1

# Authentication — MUST be >= 32 characters in production!
# Generate with: openssl rand -base64 48
DYPOS_JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# JWT expiry (e.g. 24h, 7d). Shorter = safer at scale (use refresh flow for POS terminals)
DYPOS_JWT_EXPIRES=24h

# Database (SQLite single-file; WAL enabled in code)
# For development: relative path
DYPOS_DB_PATH=/app/data/dypos.db
# Horizontal scale note: SQLite is single-writer. For multi-replica writes,
# front with a single writer replica (see docker-compose) or migrate to
# Postgres (DYPOS_DB_PATH=postgresql://... reserved for future driver).

# CORS — set to your front-end domain(s), comma-separated
# NEVER use "*" in production when credentials are required!
DYPOS_CORS_ORIGIN=https://pos.example.com

# Prometheus metrics gate — set to require token (?token=... or X-Metrics-Token)
# Leave empty to expose openly inside a private network only.
# DYPOS_METRICS_TOKEN=change-me

# Observability
DYPOS_LOG_LEVEL=info

# ── DB mode ──
# Tier-1 SQLite primary (default). Replica: DYPOS_READ_ONLY=1 + DYPOS_PRIMARY_URL=https://primary:3001
# Tier-2 Postgres: DYPOS_DATABASE_URL=postgres://... → boot refuses until pg driver lands (see docs/DB_DECISION.md)
# DYPOS_DATABASE_URL=
# DYPOS_READ_ONLY=0
# DYPOS_PRIMARY_URL=

# ── Backups (VACUUM INTO + retention + optional S3) ──
DYPOS_BACKUP_DIR=./data/backups
DYPOS_BACKUP_RETENTION=7
# DYPOS_BACKUP_S3=s3://my-bucket/dypos

# Frontend dist path (where Vite build output lives)
# DYPOS_FRONTEND_DIST=/app/DyPOS/public/pos

# Seed bootstrap (only used by `npm run seed`)
# DYPOS_ADMIN_PASSWORD=
# DYPOS_CASHIER_PASSWORD=
