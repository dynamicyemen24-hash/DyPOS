# ─────────────────────────────────────────────────────────
# DyPOS Server — Environment Configuration (production-ready)
# ─────────────────────────────────────────────────────────
# Copy to .env and fill in values:
#   cp .env.example .env

# Server
DYPOS_PORT=3001
DYPOS_HOST=0.0.0.0
NODE_ENV=production

# Multi-core throughput: 1 = fork one worker per CPU.
# ⚠ POSTGRES-ONLY (Tier-2): with the SQLite driver (Tier-1 default) the server
# REFUSES to boot with DYPOS_CLUSTER=1 (single-writer: zero write scale-out +
# duplicate webhook dispatchers — see the FATAL message). SQLite deployments
# MUST leave this unset (single process is the correct Tier-1 topology).
# Optionally cap with DYPOS_WORKERS=4
# DYPOS_CLUSTER=1
# DYPOS_WORKERS=4

# Timeouts / limits (DoS + slow-client protection)
DYPOS_SERVER_TIMEOUT=30000
DYPOS_BODY_LIMIT=1mb
DYPOS_TRUST_PROXY=1
# Rate limits (per IP / 15 min window; raise for load campaigns)
# DYPOS_RATE_LIMIT_MAX=2000
# DYPOS_AUTH_LIMIT_MAX=30

# Authentication — MUST be >= 32 characters in production!
# Generate with: openssl rand -base64 48
DYPOS_JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# JWT expiry (e.g. 24h, 7d). Shorter = safer at scale (use refresh flow for POS terminals)
DYPOS_JWT_EXPIRES=24h

# Database (SQLite single-file; WAL enabled in code)
# For development: relative path
DYPOS_DB_PATH=/app/data/dypos.db
# Horizontal scale note: SQLite is single-writer. For multi-replica writes,
# front with a single writer replica (see docker-compose) or migrate to
# Postgres (DYPOS_DB_PATH=postgresql://... reserved for future driver).

# CORS — set to your front-end domain(s), comma-separated
# NEVER use "*" in production when credentials are required!
DYPOS_CORS_ORIGIN=https://pos.example.com

# Prometheus metrics gate — set to require token (?token=... or X-Metrics-Token)
# Leave empty to expose openly inside a private network only.
# DYPOS_METRICS_TOKEN=change-me

# Observability
DYPOS_LOG_LEVEL=info

# ── DB mode ──
# Tier-1 SQLite primary (default). Replica: DYPOS_READ_ONLY=1 + DYPOS_PRIMARY_URL=https://primary:3001
# Tier-2 Postgres: DYPOS_DATABASE_URL=postgres://... → boot refuses until pg driver lands (see docs/DB_DECISION.md)
# DYPOS_DATABASE_URL=
# DYPOS_READ_ONLY=0
# DYPOS_PRIMARY_URL=

# ── Backups (VACUUM INTO + retention + optional S3) ──
DYPOS_BACKUP_DIR=./data/backups
DYPOS_BACKUP_RETENTION=7
# DYPOS_BACKUP_S3=s3://my-bucket/dypos

# ── Integration plane ──
# CSV import payload cap (row cap 2000 enforced in code)
DYPOS_CSV_LIMIT=2mb
# Webhook dispatcher: 1 = on (default), 0 = off (external worker drains outbox)
# DYPOS_WEBHOOKS=1

# ── Scale plane (millions of sessions) ──
# Read-through cache TTL for catalog/stock (seconds). 5s absorbs browse storms,
# writes invalidate instantly (products/stock create/update/delete → cacheDel).
DYPOS_CACHE_TTL=5
DYPOS_CACHE_MAX=2000
# Shared cache + rate-limit store for multi-replica/cluster deploys.
# When set AND `ioredis` installed, catalog cache is shared across workers.
# Without it, each worker keeps an in-process LRU (correct, but hit-rate × 1/N).
# DYPOS_REDIS_URL=redis://localhost:6379
# ZATCA e-invoicing QR (TLV). When VAT number is set, /api/print/invoice/:id
# embeds a ZATCA-compliant QR (X-QR-Kind: zatca-tlv); otherwise JSON QR (dev).
# DYPOS_SELLER_NAME=DyPOS Store
# DYPOS_VAT_NUMBER=300000000000003

# ── Loyalty / shifts / audit (v1.6.0+) ──
# Points → wallet rate (SAR per point). Earn stays floor(total/10).
DYPOS_LOYALTY_RATE=0.1
# Variance requiring manager approval on shift close (SAR).
DYPOS_SHIFT_VARIANCE_LIMIT=100
# In-memory audit ring for GET /api/admin/audit (entries).
DYPOS_AUDIT_RING=500
# Strict chains: 1 = invoices require an OPEN shiftId (default 0 = walk-in allowed).
# DYPOS_REQUIRE_SHIFT=0
# Strict tenancy: 1 = business writes require X-Tenant-Id (default 0 = permissive).
# DYPOS_REQUIRE_TENANT=0
# Low-stock threshold for GET /api/stock?low=1 + health gauge + alert.
DYPOS_LOW_STOCK_THRESHOLD=5
# Stock oversell policy on POST /api/invoices (C1+C5):
#   legacy (default) = untracked walk-in SKUs sell unlimited (backward compatible);
#   strict = every sellable SKU must carry a stock_levels row, missing = 409.
# Enable strict on the origin only after stocking all sellable SKUs.
# DYPOS_STOCK_GUARD=legacy

# Frontend dist path (where Vite build output lives)
# DYPOS_FRONTEND_DIST=/app/DyPOS/public/pos

# Seed bootstrap (only used by `npm run seed`)
# DYPOS_ADMIN_PASSWORD=
# DYPOS_CASHIER_PASSWORD=
