# DyPOS Cloudflare Pages cache rules v1.33.0
# Release signals must NEVER be cached — otherwise mobiles/desktops
# keep seeing the old version after a deploy.
/assets/DyPOS/pos/version.json
  Cache-Control: no-store, must-revalidate
/assets/DyPOS/pos/release.json
  Cache-Control: no-store, must-revalidate
/assets/DyPOS/pos/sw.js
  Cache-Control: no-store, must-revalidate
/assets/DyPOS/pos/manifest.webmanifest
  Cache-Control: no-store, must-revalidate
# Hashed build assets are content-addressed — safe to cache hard.
/assets/DyPOS/pos/assets/*
  Cache-Control: public, max-age=31536000, immutable
