/manifest.webmanifest
  Content-Type: application/manifest+json
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; connect-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self';

/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; connect-src 'self' https://dypos.smartportssoft.com https://dypos.smartportssoft.com/cdn-cgi/rum; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self';

# The service worker is a mutable entry point, not a content-hashed asset.
# Keep this specific rule after the JavaScript wildcard so it wins for /sw.js.
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
  Service-Worker-Allowed: /
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://dypos.smartportssoft.com https://static.cloudflareinsights.com; worker-src 'self' blob:; connect-src 'self' https://dypos.smartportssoft.com https://dypos.smartportssoft.com/cdn-cgi/rum; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self';

/assets/*
  Cache-Control: public, max-age=2592000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; connect-src 'self' https://dypos.smartportssoft.com https://dypos.smartportssoft.com/cdn-cgi/rum; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self';

