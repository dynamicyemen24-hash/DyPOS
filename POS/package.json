{
  "name": "pos-next-frontend",
  "private": true,
  "version": "1.29.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-frappe-ui-windows.js",
    "dev": "vite",
    "build": "vite build --base=/assets/DyPOS/pos/",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "vitest run && biome lint --only=suspicious/noConsole src tests",
    "copy-html-entry": "cp ../DyPOS/public/pos/index.html ../DyPOS/www/pos.html"
  },
  "dependencies": {
    "@abdulrysr/saudi-riyal-new-symbol-font": "^1.0.8",
    "@babel/helper-compilation-targets": "^7.28.6",
    "@fontsource/cairo": "^5.3.0",
    "@pinia/testing": "^1.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^10.11.1",
    "browserslist": "^4.29.0",
    "chart.js": "^4.5.1",
    "core-js-compat": "^3.48.0",
    "dexie": "^4.4.6",
    "feather-icons": "^4.29.2",
    "frappe-ui": "^0.1.278",
    "pinia": "^3.0.4",
    "qz-tray": "^2.2.5",
    "socket.io-client": "^4.7.2",
    "vue": "3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@iconify-json/lucide": "^1.2.135",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.25",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-static-copy": "^1.0.6",
    "vitest": "^2.1.9",
    "workbox-build": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "resolutions": {
    "baseline-browser-mapping": "^2.9.19"
  }
}
