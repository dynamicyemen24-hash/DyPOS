NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/smartports_pos
JWT_SECRET=change-me-to-a-secure-32-character-minimum-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY=2592000
OWNER_OPEN_ID=owner@smartports.com
OWNER_PASSWORD=secure-owner-password
PORT=3000
APP_URL=https://yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CORS_ORIGIN=https://yourdomain.com
ZATCA_MODE=production
ZATCA_API_URL=https://api.zatca.gov.sa/e-invoicing/phase2/
ZATCA_CERTIFICATE_PATH=/path/to/zatca.p12
SENTRY_DSN=https://xxx@sentry.io/xxx
