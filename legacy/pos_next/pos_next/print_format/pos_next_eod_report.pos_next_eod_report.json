    "html": "<style>\n    @page { size: A4 auto; margin: 0mm; }\n    body {\n        font-family: 'Cairo', 'DejaVu Sans', 'Arial', sans-serif;\n        margin: 0 auto;\n        padding: 20px;\n        font-size: 11px;\n        line-height: 1.5;\n        direction: rtl;\n    }\n    .header {\n        text-align: center;\n        border-bottom: 3px solid #1E40AF;\n        padding-bottom: 15px;\n        margin-bottom: 20px;\n    }\n    .company-name {\n        font-size: 24px;\n        font-weight: bold;\n        color: #1E40AF;\n    }\n    .report-title {\n        font-size: 18px;\n        font-weight: bold;\n        color: #333;\n        margin-top: 10px;\n    }\n    .report-date {\n        font-size: 12px;\n        color: #666;\n    }\n    .divider {\n        border-top: 2px solid #E5E7EB;\n        margin: 15px 0;\n    }\n    .summary-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 15px 0;\n    }\n    .summary-table th, .summary-table td {\n        padding: 8px 12px;\n        text-align: right;\n        border-bottom: 1px solid #E5E7EB;\n    }\n    .summary-table th {\n        background-color: #1E40AF;\n        color: white;\n        font-weight: bold;\n    }\n    .summary-table tr:nth-child(even) {\n        background-color: #F9FAFB;\n    }\n    .total-row {\n        font-size: 16px;\n        font-weight: bold;\n        border-top: 2px solid #1E40AF;\n        padding-top: 10px;\n        margin-top: 10px;\n        background-color: #E5E7EB;\n    }\n    .footer {\n        border-top: 2px solid #1E40AF;\n        margin-top: 20px;\n        padding-top: 10px;\n        text-align: center;\n        font-size: 10px;\n        color: #666;\n    }\n    .section {\n        margin-bottom: 20px;\n    }\n    .section-title {\n        font-size: 14px;\n        font-weight: bold;\n        color: #1E40AF;\n        margin-bottom: 10px;\n    }\n    @media print {\n        body { padding: 10mm; }\n    }\n</style>\n\n<div class=\"header\">\n    <div class=\"company-name\">المنافذ الذكية للبرمجيات</div>\n    <div class=\"report-title\">تقرير إغلاق الشيفت</div>\n    <div class=\"report-date\">{{ doc.posting_date }}</div>\n</div>\n\n<div class=\"divider\"></div>\n\n<div class=\"section\">\n    <div class=\"section-title\">ملخص الشيفت</div>\n    <table class=\"summary-table\">\n        <tr>\n            <th>البند</th>\n            <th>القيمة</th>\n        </tr>\n        <tr>\n            <td>إجمالي المبيعات</td>\n            <td>{{ doc.grand_total }} {{ doc.currency }}</td>\n        </tr>\n        <tr>\n            <td>صافي الإجمالي</td>\n            <td>{{ doc.net_total }} {{ doc.currency }}</td>\n        </tr>\n        <tr>\n            <td>المبلغ المجمع</td>\n            <td>{{ doc.collected_amount }} {{ doc.currency }}</td>\n        </tr>\n        <tr>\n            <td>إجمالي الكمية</td>\n            <td>{{ doc.total_quantity }}</td>\n        </tr>\n        <tr>\n            <td>عدد المنتجات</td>\n            <td>{{ doc.items | length }}</td>\n        </tr>\n    </table>\n</div>\n\n<div class=\"footer\">\n    <div>شكراً لتعاملكم مع المنافذ الذكية</div>\n    <div>تقرير إغلاق الشيفت - {{ doc.posting_date }}</div>\n</div>\n",
